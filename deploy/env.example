# 复制为 deploy/.env 后按新服务器实际情况修改：
#   cp deploy/env.example deploy/.env

# ── 目录挂载（docker run -v 使用）
WORKSPACE_ROOT=/home/mx          # 代码与 qwen/ 产物根目录
MODEL_ROOT=/mnt                  # 模型权重根目录

# ── Docker 镜像与容器名
CLI_IMAGE=vimax:v1               # 跑 auto_storyboard 的容器镜像
GPU_IMAGE=ltx2:v1                # 跑 Qwen-Image / LTX 推理的镜像
CONTAINER_CLI=whw                # 工作流 CLI 容器名
CONTAINER_QWEN=qwen_image        # Qwen-Image 服务容器名（可选，独立容器时使用）
CONTAINER_LTX=ltx2.3_0309        # LTX 服务容器名（可选）

SHM_SIZE=100gb

# ── 推理服务地址（host 网络下一般为 127.0.0.1）
QWEN_IMAGE_BASE_URL=http://127.0.0.1:9000
LTX_BASE_URL=http://127.0.0.1:8000

# ── 模型路径（修改各服务 launch.sh 或 export 后传入）
QWEN_IMAGE_MODEL_PATH=/mnt/customer-fs/plin/Qwen-Image-2512
QWEN_IMAGE_EDIT_MODEL_PATH=/mnt/customer-fs/plin/Qwen-Image-Edit-2511
LTX_CHECKPOINT_PATH=/mnt/customer-fs/plin/ltx_23/ltx-2.3-22b-dev.safetensors
LTX_DISTILLED_LORA=/mnt/customer-fs/plin/ltx_23/ltx-2.3-22b-distilled-lora-384.safetensors
LTX_SPATIAL_UPSAMPLER=/mnt/customer-fs/plin/ltx_23/ltx-2.3-spatial-upscaler-x2-1.0.safetensors
LTX_GEMMA_ROOT=/mnt/customer-fs/jyfa/ckpt/gemma-3-12b-it

# Qwen-Image 使用的 GPU 编号（逗号分隔）
QWEN_GPU_DEVICES=2,3,4,5,6,7
# LTX 使用的 GPU 编号
LTX_GPU_DEVICES=1

# ── 推理服务代码路径（相对 WORKSPACE_ROOT 或绝对路径）
QWEN_SERVICE_DIR=/home/mx/plin/Image/service
LTX_SERVICE_DIR=/home/mx/plin/aigc_services/LTX-2_0318/service

# ── VLM（云端 API，勿提交真实 Key 到 Git）
VLM_PROVIDER=gitee
GITEE_AI_API_KEY=
DASHSCOPE_API_KEY=
